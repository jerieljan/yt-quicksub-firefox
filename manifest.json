{
  "manifest_version": 3,
  "name": "yt-quicksub",
  "version": "0.1.5",
  "description": "Download the current YouTube video's captions as a readable, retimed SRT file.",
  "action": {
    "default_title": "yt-quicksub",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "background": {
    "scripts": ["src/background.js"]
  },
  "permissions": ["webRequest"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["src/core.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "@yt-quicksub.jerieljan",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
